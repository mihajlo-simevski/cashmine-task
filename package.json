    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.16",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^3.4.19",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@11.0.8"
