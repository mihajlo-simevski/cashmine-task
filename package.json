{
  "name": "cashmine-task",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "jest --no-watchman",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test",
    "export:web": "expo export --platform web --clear",
    "deploy:web": "pnpm export:web && npx eas-cli@latest deploy --environment preview",
    "deploy:web:prod": "pnpm export:web && npx eas-cli@latest deploy --environment production --prod",
    "doctor": "npx expo-doctor@latest"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@tanstack/react-query": "^5.104.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.5.2",
    "lucide-react-native": "^1.59.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
